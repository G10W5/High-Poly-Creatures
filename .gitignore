# Extracted vanilla assets - regenerated by 00_extract_vanilla.py, never committed
reference/

# Assets from other mods, kept only for comparison.  These must never be
# committed and never shipped: the Nexus rules forbid another mod's textures
# in the archive, and everything we ship comes from our own models.
local_refs/

# Build output
build/
dist/
*.zip
*.7z

# Raw deliveries can be large; keep the folder layout but not the binaries
raw_assets/**/incoming/*
!raw_assets/**/incoming/.gitkeep

# Python
__pycache__/
*.pyc
.venv/

# Third-party tooling
tools/pynifly/
tools/texconv/
tools/*.zip

# Work files: exported .blend + Blender backups are large and regenerable
raw_assets/**/work/
